# prod
dist/

# dev
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/
.pnpm-store/
.wrangler

# env and secret-bearing dotenv variants (runtime env lives under platform config)
.env
.env.*
.env-*
.envrc
!.env.example
.dev.vars
.dev.vars*
!.dev.vars.example

# keys, certs, tokens, and passwords
*.pem
*.key
*.p12
*.jks
*.mobileprovision
*.token
*.secret
*.pass
server-key.json
license.token

# self-signed TLS certificate (generated by scripts/generate-self-signed-cert.mjs)
certs/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# test coverage (Vitest / Deno LCOV for SonarCloud)
coverage/

# misc
.DS_Store

# instance/caddy runtime (systemd HOME/XDG_* for the instance user)
.local/
.cache/
.config/

# browser singleton locks (created when Chromium/Firefox uses this dir as a profile)
SingletonCookie
SingletonLock
SingletonSocket

# co-located dev host stamp (normalize-dev-checkout.sh)
.turbopanel-checkout-stamp
