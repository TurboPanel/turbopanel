          "simple": { "limit": 12, "period": 60 }
        },
        {
          // Topology reports (the only writer of server.metadata.hardware): a healthy daemon sends
          // one on connect and on a device change; this allows a short burst and blunts a flood.
          // Per Cloudflare location and eventually consistent: the exact limit is the 5-minute overwrite cooldown.
          "name": "DAEMON_TOPOLOGY_RATE_LIMITER",
          "namespace_id": "3011",
          "simple": { "limit": 4, "period": 60 }
        },
        {
          "name": "GITHUB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "3006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "GITLAB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "3007",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          // Inbound Stripe events (`/webhook/stripe`). Same gate, its own bucket,
