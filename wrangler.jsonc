{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "turbopanel",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-01",
  "dev": {
    "port": 18787
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "env": {
    "testing": {
      "name": "turbopanel-testing",
      "route": {
        "pattern": "testing.turbopanel.dev/api/*",
        "zone_name": "turbopanel.dev"
      }
    }
  }
}
