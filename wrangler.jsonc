{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "dev-instance",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "nodemailer": "./src/lib/email/smtp/nodemailer-shim.ts",
    "@turbopanel/email/smtp-sender": "./src/lib/email/smtp/smtp-sender-shim.ts"
  },
  "dev": {
    "port": 18787,
    "ip": "0.0.0.0"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
    },
    {
      // TODO: replace with real dev cached Hyperdrive config id
      "binding": "HYPERDRIVE_CACHED",
      "id": "0000000000000000000000000000dev0"
    }
  ],
  "queues": {
    "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "dev-daemon-commands" }],
    "consumers": [
      {
        "queue": "dev-daemon-commands",
        "dead_letter_queue": "dev-daemon-commands-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAEMON_CELL",
        "class_name": "DaemonCellObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-daemon-cell",
      "new_sqlite_classes": ["DaemonCellObject"]
    }
  ],
  "env": {
    "testing": {
      "queues": {
        "producers": [
          { "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "staging-daemon-commands" }
        ],
        "consumers": [
          {
            "queue": "staging-daemon-commands",
            "dead_letter_queue": "staging-daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
        },
        {
          // TODO: replace with real dev cached Hyperdrive config id
          "binding": "HYPERDRIVE_CACHED",
          "id": "0000000000000000000000000000dev0"
        }
      ],
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://testing.turbopanel.dev",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://testing.turbopanel.io",
        "TURBOPANEL_IS_SIGNUP_ENABLED": "1"
      }
    },
    "live": {
      "name": "instance",
      "queues": {
        "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "daemon-commands" }],
        "consumers": [
          {
            "queue": "daemon-commands",
            "dead_letter_queue": "daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "routes": [
        {
          "pattern": "turbopanel.app/api/*",
          "zone_name": "turbopanel.app"
        },
        {
          "pattern": "turbopanel.app/ws/*",
          "zone_name": "turbopanel.app"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1eaf503302aa4936895ca2cf9963037f"
        },
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "d9c42999730048e2842dccb61aa05d67"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://turbopanel.app",
        "TURBOPANEL_IS_SIGNUP_ENABLED": "0",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://turbopanel.io"
      }
    }
  }
}
