{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "dev-instance",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "nodemailer": "./src/lib/email/smtp/nodemailer-shim.ts",
    "@turbopanel/email/smtp-sender": "./src/lib/email/smtp/smtp-sender-shim.ts"
  },
  "dev": {
    "port": 18787,
    "ip": "0.0.0.0"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAEMON_CELL",
        "class_name": "DaemonCellObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-daemon-cell",
      "new_sqlite_classes": ["DaemonCellObject"]
    }
  ],
  "env": {
    "testing": {
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
        }
      ],
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        }
      ],
      "vars": {
        "TURBOPANEL_PBKDF2_ITERATIONS": "100000",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://testing.turbopanel.io",
        "TURBOPANEL_IS_SIGNUP_ENABLED": "0"
      }
    },
    "live": {
      "name": "instance",
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "routes": [
        {
          "pattern": "turbopanel.app/api/*",
          "zone_name": "turbopanel.app"
        },
        {
          "pattern": "turbopanel.app/ws/*",
          "zone_name": "turbopanel.app"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "91114c98e51f4f77967f0ee3e7f510e4"
        }
      ],
      "vars": {
        "TURBOPANEL_IS_SIGNUP_ENABLED": "1",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://turbopanel.io"
      }
    }
  }
}
