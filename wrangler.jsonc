{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  // Preserve dashboard-only plaintext vars across `wrangler deploy` (notably
  // live TURBOPANEL_IS_SIGNUP_ENABLED, which must not be committed in env.live
  // or every deploy would overwrite the Cloudflare dashboard value).
  "keep_vars": true,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "dev-instance",
  "main": "src/workers.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "nodemailer": "./src/lib/email/smtp/nodemailer-shim.ts",
    "@turbopanel/email/smtp-sender": "./src/lib/email/smtp/smtp-sender-shim.ts"
  },
  "dev": {
    "port": 18787,
    "ip": "0.0.0.0"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0000000000000000000000000000dev0"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "0000000000000000000000000000dev1"
    }
  ],
  "queues": {
    "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "dev-daemon-commands" }],
    "consumers": [
      {
        "queue": "dev-daemon-commands",
        "dead_letter_queue": "dev-daemon-commands-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAEMON_CELL",
        "class_name": "DaemonCellObject"
      }
    ]
  },
  // Daemon WS-upgrade / REST / metrics / container-log rate limits, plus the
  // inbound GitHub webhook throttle — distinct namespace_ids per env (account-global counters).
  "ratelimits": [
    {
      "name": "DAEMON_CONNECT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "DAEMON_REST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Client auth throttle (sign-in/sign-up/OTP/install), globally shared across isolates.
      "name": "CLIENT_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Host-metrics ingest (~1 sample/min/server) with small reconnect burst.
      "name": "DAEMON_METRICS_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      // Container-log ingest. Dedicated so batched container output cannot
      // spend the shared REST budget enroll/session/decrypt depend on.
      "name": "CONTAINER_LOGS_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Inbound GitHub webhooks. Keyed per peer address (the caller has no
      // identity until its HMAC is verified), sized for a real delivery burst.
      "name": "GITHUB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Inbound GitLab webhooks. Its own bucket, so a pipeline-hook flood from
      // one provider cannot start dropping the other's deliveries.
      "name": "GITLAB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Offline sweep (see src/daemon/cell/offline-sweep.ts) — 1 minute is Cloudflare's
  // finest cron granularity, matching the 60s daemon idle-ping cadence.
  "triggers": { "crons": ["* * * * *"] },
  // Host metrics (Workers Analytics Engine). Dataset name is reused across
  // envs — AE datasets are account-scoped and auto-created on first write;
  // docs do not require globally unique names. Rows are keyed by index1=serverId.
  // SQL API reads need secrets: TURBOPANEL_ANALYTICS_ENGINE_API_TOKEN
  // (Account Analytics Read) plus CLOUDFLARE_ACCOUNT_ID (vars below / .dev.vars).
  // Optional: TURBOPANEL_SERVER_METRICS_AE_MAX_RANGE_SECONDS (default = 90-day AE retention).
  "analytics_engine_datasets": [
    {
      "binding": "SERVER_METRICS",
      "dataset": "turbopanel_server_metrics"
    }
  ],
  // Command execution logs (transcripts). Buckets are NOT auto-created — create
  // each one before the first deploy to that env (`wrangler r2 bucket create <name>`),
  // same manual-prerequisite convention as the Hyperdrive ids above.
  // Keyed-object storage, not an analytics table: a transcript is only ever
  // fetched by command id. See src/lib/execution-logs/AGENTS.md.
  "r2_buckets": [
    {
      "binding": "EXECUTION_LOGS",
      "bucket_name": "dev-turbopanel-execution-logs"
    }
  ],
  // Container logs (stdout/stderr of running containers) — Pipelines in,
  // R2 SQL out. The Pipeline (Stream) sinks into an Apache Iceberg table in R2
  // Data Catalog; reads go through the R2 SQL HTTP API. NOT auto-created —
  // provision the stream, sink and Data Catalog table before the first deploy
  // to that env (`wrangler pipelines setup`), same manual-prerequisite
  // convention as the r2_buckets and Hyperdrive ids above.
  // Reads need the secret TURBOPANEL_CONTAINER_LOGS_R2_SQL_API_TOKEN (R2 SQL +
  // R2 Data Catalog + R2 storage read) plus CLOUDFLARE_ACCOUNT_ID and the
  // TURBOPANEL_CONTAINER_LOGS_R2_SQL_* vars below.
  // Default-off: nothing is written unless TURBOPANEL_CONTAINER_LOGS_ENABLED is
  // truthy. See src/lib/container-logs/AGENTS.md.
  //
  // There is deliberately NO `pipelines` binding checked in here. Wrangler
  // resolves bindings at deploy time, so a committed placeholder stream id
  // would put this beta backend on the deploy critical path for every env —
  // including envs that have container logs switched off or not yet
  // provisioned. Instead, add the binding to this env block only once the real
  // stream exists:
  //
  //   "pipelines": [{ "binding": "CONTAINER_LOGS", "stream": "<real stream id>" }]
  //
  // Until then `env.CONTAINER_LOGS` is simply absent and
  // `resolveContainerLogStore` falls back to `DisabledContainerLogStore` —
  // the runtime resolver is the only activation gate.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
    // Container logs (default-off; set to 1/true/yes/on to retain container
    // stdout/stderr). See src/lib/container-logs/AGENTS.md.
    "TURBOPANEL_CONTAINER_LOGS_ENABLED": "0",
    // R2 bucket backing the Data Catalog warehouse the Iceberg table lives in.
    "TURBOPANEL_CONTAINER_LOGS_R2_SQL_BUCKET": "dev-turbopanel-container-logs",
    // Catalog identifier of the table, as `namespace.table`.
    "TURBOPANEL_CONTAINER_LOGS_ICEBERG_TABLE": "default.container_logs",
    // Transcript retention window in days (positive integer). Anything else
    // falls back to the 30-day default — parity with the Deno
    // TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS env var.
    "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "30"
  },
  "exports": {
    "DaemonCellObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "testing": {
      "queues": {
        "producers": [
          { "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "staging-daemon-commands" }
        ],
        "consumers": [
          {
            "queue": "staging-daemon-commands",
            "dead_letter_queue": "staging-daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "DAEMON_CONNECT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "DAEMON_REST_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "DAEMON_METRICS_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "CONTAINER_LOGS_RATE_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "GITHUB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "2006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "GITLAB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "2007",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "analytics_engine_datasets": [
        {
          "binding": "SERVER_METRICS",
          "dataset": "turbopanel_server_metrics"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXECUTION_LOGS",
          "bucket_name": "testing-turbopanel-execution-logs"
        }
      ],
      // Container logs (stdout/stderr of running containers) — Pipelines in,
      // R2 SQL out. The Pipeline (Stream) sinks into an Apache Iceberg table in R2
      // Data Catalog; reads go through the R2 SQL HTTP API. NOT auto-created —
      // provision the stream, sink and Data Catalog table before the first deploy
      // to that env (`wrangler pipelines setup`), same manual-prerequisite
      // convention as the r2_buckets and Hyperdrive ids above.
      // Reads need the secret TURBOPANEL_CONTAINER_LOGS_R2_SQL_API_TOKEN (R2 SQL +
      // R2 Data Catalog + R2 storage read) plus CLOUDFLARE_ACCOUNT_ID and the
      // TURBOPANEL_CONTAINER_LOGS_R2_SQL_* vars below.
      // Default-off: nothing is written unless TURBOPANEL_CONTAINER_LOGS_ENABLED is
      // truthy. See src/lib/container-logs/AGENTS.md.
      //
      // There is deliberately NO `pipelines` binding checked in here. Wrangler
      // resolves bindings at deploy time, so a committed placeholder stream id
      // would put this beta backend on the deploy critical path for every env —
      // including envs that have container logs switched off or not yet
      // provisioned. Instead, add the binding to this env block only once the real
      // stream exists:
      //
      //   "pipelines": [{ "binding": "CONTAINER_LOGS", "stream": "<real stream id>" }]
      //
      // Until then `env.CONTAINER_LOGS` is simply absent and
      // `resolveContainerLogStore` falls back to `DisabledContainerLogStore` —
      // the runtime resolver is the only activation gate.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
        },
        {
          // Create via scripts/ensure-testing-hyperdrive-cached.sh — must be a dedicated
          // cached config for the testing Postgres origin (not the primary HYPERDRIVE id).
          "binding": "HYPERDRIVE_CACHED",
          "id": "0000000000000000000000000000dev0"
        }
      ],
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://testing.turbopanel.dev",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://testing.turbopanel.io",
        "TURBOPANEL_IS_SIGNUP_ENABLED": "1",
        "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
        "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "30",
        // Container logs (default-off; set to 1/true/yes/on to retain container
        // stdout/stderr). See src/lib/container-logs/AGENTS.md.
        "TURBOPANEL_CONTAINER_LOGS_ENABLED": "0",
        // R2 bucket backing the Data Catalog warehouse the Iceberg table lives in.
        "TURBOPANEL_CONTAINER_LOGS_R2_SQL_BUCKET": "testing-turbopanel-container-logs",
        // Catalog identifier of the table, as `namespace.table`.
        "TURBOPANEL_CONTAINER_LOGS_ICEBERG_TABLE": "default.container_logs"
      }
    },
    "live": {
      "name": "instance",
      "queues": {
        "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "daemon-commands" }],
        "consumers": [
          {
            "queue": "daemon-commands",
            "dead_letter_queue": "daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "DAEMON_CONNECT_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "DAEMON_REST_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_RATE_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "DAEMON_METRICS_RATE_LIMITER",
          "namespace_id": "3004",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "CONTAINER_LOGS_RATE_LIMITER",
          "namespace_id": "3005",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "GITHUB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "3006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "GITLAB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "3007",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "analytics_engine_datasets": [
        {
          "binding": "SERVER_METRICS",
          "dataset": "turbopanel_server_metrics"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXECUTION_LOGS",
          "bucket_name": "turbopanel-execution-logs"
        }
      ],
      // Container logs (stdout/stderr of running containers) — Pipelines in,
      // R2 SQL out. The Pipeline (Stream) sinks into an Apache Iceberg table in R2
      // Data Catalog; reads go through the R2 SQL HTTP API. NOT auto-created —
      // provision the stream, sink and Data Catalog table before the first deploy
      // to that env (`wrangler pipelines setup`), same manual-prerequisite
      // convention as the r2_buckets and Hyperdrive ids above.
      // Reads need the secret TURBOPANEL_CONTAINER_LOGS_R2_SQL_API_TOKEN (R2 SQL +
      // R2 Data Catalog + R2 storage read) plus CLOUDFLARE_ACCOUNT_ID and the
      // TURBOPANEL_CONTAINER_LOGS_R2_SQL_* vars below.
      // Default-off: nothing is written unless TURBOPANEL_CONTAINER_LOGS_ENABLED is
      // truthy. See src/lib/container-logs/AGENTS.md.
      //
      // There is deliberately NO `pipelines` binding checked in here. Wrangler
      // resolves bindings at deploy time, so a committed placeholder stream id
      // would put this beta backend on the deploy critical path for every env —
      // including envs that have container logs switched off or not yet
      // provisioned. Instead, add the binding to this env block only once the real
      // stream exists:
      //
      //   "pipelines": [{ "binding": "CONTAINER_LOGS", "stream": "<real stream id>" }]
      //
      // Until then `env.CONTAINER_LOGS` is simply absent and
      // `resolveContainerLogStore` falls back to `DisabledContainerLogStore` —
      // the runtime resolver is the only activation gate.
      "routes": [
        {
          "pattern": "turbopanel.app/api/*",
          "zone_name": "turbopanel.app"
        },
        {
          "pattern": "turbopanel.app/ws/*",
          "zone_name": "turbopanel.app"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1eaf503302aa4936895ca2cf9963037f"
        },
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "d9c42999730048e2842dccb61aa05d67"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://turbopanel.app",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://turbopanel.io",
        "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
        "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "30",
        // Container logs (default-off; set to 1/true/yes/on to retain container
        // stdout/stderr). See src/lib/container-logs/AGENTS.md.
        "TURBOPANEL_CONTAINER_LOGS_ENABLED": "0",
        // R2 bucket backing the Data Catalog warehouse the Iceberg table lives in.
        "TURBOPANEL_CONTAINER_LOGS_R2_SQL_BUCKET": "turbopanel-container-logs",
        // Catalog identifier of the table, as `namespace.table`.
        "TURBOPANEL_CONTAINER_LOGS_ICEBERG_TABLE": "default.container_logs"
      }
    }
  }
}
