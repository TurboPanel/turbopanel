{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "turbopanel",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-01",
  "dev": {
    "port": 18787
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // Set SESSION_SECRET in .dev.vars for local `pnpm dev`; use `wrangler secret put SESSION_SECRET` in production.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "env": {
    "testing": {
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        }
      ]
    }
  }
}
