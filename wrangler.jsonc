{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  // Preserve dashboard-only plaintext vars across `wrangler deploy` (notably
  // live TURBOPANEL_IS_SIGNUP_ENABLED, which must not be committed in env.live
  // or every deploy would overwrite the Cloudflare dashboard value).
  "keep_vars": true,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "dev-instance",
  "main": "src/workers.ts",
  // Runs before wrangler bundles on every deploy / versions upload / dev.
  // Inside Cloudflare Workers Builds it stamps the deploying commit into
  // BUILD_INFO so /api/health names it even for a plain `wrangler deploy`;
  // everywhere else WORKERS_CI_COMMIT_SHA is unset and it does nothing.
  "build": {
    "command": "[ -z \"$WORKERS_CI_COMMIT_SHA\" ] || node scripts/stamp-build-commit.mjs"
  },
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "nodemailer": "./src/features/email/smtp/nodemailer-shim.ts",
    "@turbopanel/email/smtp-sender": "./src/features/email/smtp/smtp-sender-shim.ts"
  },
  "dev": {
    "port": 18787,
    "ip": "0.0.0.0"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0000000000000000000000000000dev0"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "0000000000000000000000000000dev1"
    }
  ],
  "queues": {
    "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "dev-daemon-commands" }],
    "consumers": [
      {
        "queue": "dev-daemon-commands",
        "dead_letter_queue": "dev-daemon-commands-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAEMON_CELL",
        "class_name": "DaemonCellObject"
      },
      {
        "name": "METRICS_GATE",
        "class_name": "MetricsGateObject"
      }
    ]
  },
  // Daemon WS-upgrade / REST / metrics / container-log rate limits, plus the
  // inbound webhook throttles (GitHub / GitLab / Stripe) — distinct
  // namespace_ids per env (account-global counters).
  "ratelimits": [
    {
      "name": "DAEMON_CONNECT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "DAEMON_REST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Client auth throttle (sign-in/sign-up/OTP/install), globally shared across isolates.
      "name": "CLIENT_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Stricter budget for sign-up / send-otp / reset-password request — see
      // AUTH_RATE_LIMIT_PURPOSE_TIERS in client/authn/auth-rate-limit.ts.
      "name": "CLIENT_AUTH_STRICT_RATE_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Host-metrics ingest: 1 baseline/min/server, plus a 10 s live stream while a
      // live lease is open (about 9 POSTs/min with the reconnect primer).
      "name": "DAEMON_METRICS_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      // Topology reports (the only writer of server.metadata.hardware): a healthy daemon sends
      // one on connect and on a device change; this allows a short burst and blunts a flood.
      // Per Cloudflare location and eventually consistent: the exact limit is the 5-minute overwrite cooldown.
      "name": "DAEMON_TOPOLOGY_RATE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      // Inbound GitHub webhooks. Keyed per peer address (the caller has no
      // identity until its HMAC is verified), sized for a real delivery burst.
      "name": "GITHUB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Inbound GitLab webhooks. Its own bucket, so a pipeline-hook flood from
      // one provider cannot start dropping the other's deliveries.
      "name": "GITLAB_WEBHOOK_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Inbound Stripe events (`/webhook/stripe`). Same gate, its own bucket,
      // and a modest budget — Stripe delivery volume is far below a push fan-out.
      "name": "STRIPE_WEBHOOK_RATE_LIMITER",
      "namespace_id": "1009",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Generic mutating-request cap (client/admin/install/developer writes), keyed
      // per signed session or per IP — see src/app/write-rate-limit.ts. Generous: an
      // abuse ceiling, not pacing. A missing binding means no limit (fails open).
      "name": "CLIENT_WRITE_RATE_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Offline sweep (see src/daemon/cell/offline-sweep.ts) — 1 minute is Cloudflare's
  // finest cron granularity, matching the 60s daemon idle-ping cadence.
  "triggers": { "crons": ["* * * * *"] },
  // Host metrics (Workers Analytics Engine). AE datasets are account-scoped and
  // auto-created on first write. Each environment (testing, staging, live) has
  // its OWN dataset, `<env>_turbopanel_server_metrics_v8`, so their rows, retention
  // and any reset never mix; the top level (local `wrangler dev`) keeps the bare
  // name. The binding's `dataset` is what is written; the read side (SQL API) takes
  // its table from `TURBOPANEL_SERVER_METRICS_AE_DATASET` — an env must set both to
  // the same value (guarded by src/daemon/metrics/backends/cloudflare/wrangler-datasets.test.ts).
  // Rows are keyed by index1=serverId.
  // Schema v8 (blob3 "8"): every sample writes four always-present host rows
  // (host.system, host.io, host.network, host.web), managed.database when managed
  // databases run, presence-gated pages for block/network/filesystem/gpu/
  // hardware.physical, and one row per event — see
  // src/daemon/metrics/backends/cloudflare/field-map.ts and src/daemon/metrics/V8-LAYOUT.md. `workers.ts` wires this binding
  // straight into a real `CloudflareAnalyticsEngineServerMetricsStore` for
  // both writes and reads — metric samples, status transitions, and metric
  // events all land here directly.
  // SQL API reads need secrets: TURBOPANEL_ANALYTICS_ENGINE_API_TOKEN
  // (Account Analytics Read) plus CLOUDFLARE_ACCOUNT_ID (vars below / .dev.vars).
  // Optional: TURBOPANEL_SERVER_METRICS_AE_MAX_RANGE_SECONDS (default = 90-day AE retention).
  "analytics_engine_datasets": [
    {
      "binding": "SERVER_METRICS",
      "dataset": "turbopanel_server_metrics_v8"
    }
  ],
  // Command execution logs (transcripts). Buckets are NOT auto-created — create
  // each one before the first deploy to that env (`wrangler r2 bucket create <name>`),
  // same manual-prerequisite convention as the Hyperdrive ids above.
  // Keyed-object storage, not an analytics table: a transcript is only ever
  // fetched by command id. See src/features/execution-logs/AGENTS.md.
  "r2_buckets": [
    {
      "binding": "EXECUTION_LOGS",
      "bucket_name": "dev-turbopanel-execution-logs"
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
    // The dev box runs on the local overlay catalog, which only carries trunk
    // builds; with no channel a control plane follows release.
    "TURBOPANEL_UPDATE_CHANNEL": "trunk",
    // Transcript retention window in days (positive integer). Anything else
    // falls back to the 90-day default — parity with the Deno
    // TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS env var.
    "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "90"
  },
  "exports": {
    "DaemonCellObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MetricsGateObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "testing": {
      "name": "testing-instance",
      "queues": {
        "producers": [
          { "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "testing-daemon-commands" }
        ],
        "consumers": [
          {
            "queue": "testing-daemon-commands",
            "dead_letter_queue": "testing-daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          },
          {
            "name": "METRICS_GATE",
            "class_name": "MetricsGateObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "DAEMON_CONNECT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "DAEMON_REST_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_STRICT_RATE_LIMITER",
          "namespace_id": "2008",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "DAEMON_METRICS_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          // Topology reports (the only writer of server.metadata.hardware): a healthy daemon sends
          // one on connect and on a device change; this allows a short burst and blunts a flood.
          // Per Cloudflare location and eventually consistent: the exact limit is the 5-minute overwrite cooldown.
          "name": "DAEMON_TOPOLOGY_RATE_LIMITER",
          "namespace_id": "2011",
          "simple": { "limit": 4, "period": 60 }
        },
        {
          "name": "GITHUB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "2006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "GITLAB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "2007",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          // Inbound Stripe events (`/webhook/stripe`). Same gate, its own bucket,
          // and a modest budget — Stripe delivery volume is far below a push fan-out.
          "name": "STRIPE_WEBHOOK_RATE_LIMITER",
          "namespace_id": "2009",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          // Generic mutating-request cap (client/admin/install/developer writes), keyed
          // per signed session or per IP — see src/app/write-rate-limit.ts. Generous: an
          // abuse ceiling, not pacing. A missing binding means no limit (fails open).
          "name": "CLIENT_WRITE_RATE_LIMITER",
          "namespace_id": "2010",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "analytics_engine_datasets": [
        {
          "binding": "SERVER_METRICS",
          "dataset": "testing_turbopanel_server_metrics_v8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXECUTION_LOGS",
          "bucket_name": "testing-turbopanel-execution-logs"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "3fcb0ba1b38143508e8fe60c3b45b3e6"
        },
        {
          // Create via scripts/ensure-testing-hyperdrive-cached.sh — must be a dedicated
          // cached config for the testing Postgres origin (not the primary HYPERDRIVE id).
          "binding": "HYPERDRIVE_CACHED",
          "id": "c7f506e96d1644c18d6f7fb4cd0f35ac"
        }
      ],
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        },
        // Inbound Git provider webhooks. A prefix missing from this list never
        // reaches the Worker at all — the UI Worker holds the apex as a custom
        // domain and answers unknown paths with index.html and HTTP 200, which
        // a Git provider reads as a delivered webhook and never retries.
        {
          "pattern": "testing.turbopanel.dev/webhook/*",
          "zone_name": "turbopanel.dev"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://testing.turbopanel.dev",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://testing.turbopanel.io",
        "TURBOPANEL_IS_SIGNUP_ENABLED": "1",
        "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
        "TURBOPANEL_UPDATE_CHANNEL": "canary",
        // Which deployment this is; /api/health reports it and the UI labels
        // non-production builds with it (live shows no label).
        "TURBOPANEL_ENVIRONMENT": "testing",
        // Read side of SERVER_METRICS above: must name the same dataset.
        "TURBOPANEL_SERVER_METRICS_AE_DATASET": "testing_turbopanel_server_metrics_v8",
        "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "90",
        // Upgrade tick every 5 minutes instead of 15 so a testing-fleet rollout
        // finishes in minutes. Staging and live keep the 15-minute default.
        "TURBOPANEL_UPGRADE_TICK_MINUTES": "5",
        // The testing fleet starts all at once; customer environments start
        // with one server per batch (a value saved in Admin > Updates wins).
        "TURBOPANEL_UPGRADE_BATCH": "percent:100",
        // Automatic failover (fence + promote on an accepted dead-primary
        // event). On here; staging and live keep it off until the owner turns
        // it on. Manual switchover / DR are unaffected either way.
        "TURBOPANEL_AUTO_FAILOVER": "on",
        // Firewall apply allowlist (deploy-time key of the managed-mode gate):
        // themisto, a throwaway testing server, so firewall drills can apply.
        // Testing only: staging and live never set it here (live ignores it).
        "TURBOPANEL_FIREWALL_APPLY_SERVERS": "01a0e123-9cd6-7760-96bc-5056aed162da"
      }
    },
    // Staging: the release-candidate environment. Same shape as testing and live,
    // its own everything — queue, Durable Object storage (per worker name), R2
    // bucket, rate-limit namespaces (4xxx; dev 1xxx, testing 2xxx, live 3xxx), and
    // a third Postgres reached through its own Hyperdrive pair. Follows the `rc`
    // channel. Deployed from the `staging` branch by Workers Builds.
    //
    // BEFORE THE FIRST DEPLOY (the Hyperdrive pair below already exists):
    //   1. `wrangler queues create staging-daemon-commands` and
    //      `staging-daemon-commands-dlq`.
    //   2. `wrangler r2 bucket create staging-turbopanel-execution-logs`.
    //   3. Set the secrets (BETTER_AUTH_SECRET etc.) and the Stripe / OAuth / email
    //      credentials for staging — separate from testing and live.
    // TURBOPANEL_IS_SIGNUP_ENABLED is deliberately not committed here (like live):
    // sign-up is opened from the dashboard or the admin console.
    "staging": {
      "name": "staging-instance",
      "queues": {
        "producers": [
          { "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "staging-daemon-commands" }
        ],
        "consumers": [
          {
            "queue": "staging-daemon-commands",
            "dead_letter_queue": "staging-daemon-commands-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAEMON_CELL",
            "class_name": "DaemonCellObject"
          },
          {
            "name": "METRICS_GATE",
            "class_name": "MetricsGateObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "DAEMON_CONNECT_RATE_LIMITER",
          "namespace_id": "4001",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "DAEMON_REST_RATE_LIMITER",
          "namespace_id": "4002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_RATE_LIMITER",
          "namespace_id": "4003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "CLIENT_AUTH_STRICT_RATE_LIMITER",
          "namespace_id": "4008",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "DAEMON_METRICS_RATE_LIMITER",
          "namespace_id": "4004",
          "simple": { "limit": 12, "period": 60 }
        },
        {
          // Topology reports (the only writer of server.metadata.hardware): a healthy daemon sends
          // one on connect and on a device change; this allows a short burst and blunts a flood.
          // Per Cloudflare location and eventually consistent: the exact limit is the 5-minute overwrite cooldown.
          "name": "DAEMON_TOPOLOGY_RATE_LIMITER",
          "namespace_id": "4011",
          "simple": { "limit": 4, "period": 60 }
        },
        {
          "name": "GITHUB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "4006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "GITLAB_WEBHOOK_RATE_LIMITER",
          "namespace_id": "4007",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          // Inbound Stripe events (`/webhook/stripe`). Same gate, its own bucket,
          // and a modest budget — Stripe delivery volume is far below a push fan-out.
          "name": "STRIPE_WEBHOOK_RATE_LIMITER",
          "namespace_id": "4009",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          // Generic mutating-request cap (client/admin/install/developer writes), keyed
          // per signed session or per IP — see src/app/write-rate-limit.ts. Generous: an
          // abuse ceiling, not pacing. A missing binding means no limit (fails open).
          "name": "CLIENT_WRITE_RATE_LIMITER",
          "namespace_id": "4010",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "analytics_engine_datasets": [
        {
          "binding": "SERVER_METRICS",
          "dataset": "staging_turbopanel_server_metrics_v8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXECUTION_LOGS",
          "bucket_name": "staging-turbopanel-execution-logs"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "b1147c2f45c04f85a09131c586dc8e4b"
        },
        {
          // A dedicated cached config for the staging Postgres origin (not the
          // primary HYPERDRIVE id).
          "binding": "HYPERDRIVE_CACHED",
          "id": "0d759561de73482ab13ea79f416f99f7"
        }
      ],
      "routes": [
        {
          "pattern": "staging.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "staging.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        },
        // Inbound Git provider webhooks. A prefix missing from this list never
        // reaches the Worker at all — the UI Worker holds the apex as a custom
        // domain and answers unknown paths with index.html and HTTP 200, which
        // a Git provider reads as a delivered webhook and never retries.
        {
          "pattern": "staging.turbopanel.dev/webhook/*",
          "zone_name": "turbopanel.dev"
        }
      ],
      "vars": {
        "TURBOPANEL_BASE_URL": "https://staging.turbopanel.dev",
        "TURBOPANEL_UI_CORS_ORIGINS": "https://staging.turbopanel.io",
        "CLOUDFLARE_ACCOUNT_ID": "a574c2793baa3e2276ac16e96097bc8c",
        "TURBOPANEL_UPDATE_CHANNEL": "rc",
        // Which deployment this is; /api/health reports it and the UI labels
        // non-production builds with it (live shows no label).
        "TURBOPANEL_ENVIRONMENT": "staging",
        // Read side of SERVER_METRICS above: must name the same dataset.
        "TURBOPANEL_SERVER_METRICS_AE_DATASET": "staging_turbopanel_server_metrics_v8",
        "TURBOPANEL_EXECUTION_LOG_RETENTION_DAYS": "90",
        // Automatic failover off: an accepted dead-primary event is recorded
        // as blocked (auto_failover_disabled), nothing is fenced or promoted.
        "TURBOPANEL_AUTO_FAILOVER": "off"
      }
    },
    "live": {
      "name": "instance",
      "queues": {
        "producers": [{ "binding": "TURBOPANEL_COMMAND_QUEUE", "queue": "daemon-commands" }],
        "consumers": [
          {
            "queue": "daemon-commands",
            "dead_letter_queue": "daemon-commands-dlq",
