{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "instance",
  "main": "src/workers.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 18787,
    "ip": "0.0.0.0"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
    }
  ],
  "env": {
    "testing": {
      "routes": [
        {
          "pattern": "testing.turbopanel.dev/api/*",
          "zone_name": "turbopanel.dev"
        },
        {
          "pattern": "testing.turbopanel.dev/ws/*",
          "zone_name": "turbopanel.dev"
        }
      ]
    },
    "live": {
      "name": "instance",
      "routes": [
        {
          "pattern": "turbopanel.app/api/*",
          "zone_name": "turbopanel.app"
        },
        {
          "pattern": "turbopanel.app/ws/*",
          "zone_name": "turbopanel.app"
        }
      ]
    }
  }
}
