{
  "name": "turbopanel",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cert:generate": "node scripts/generate-self-signed-cert.mjs",
    "caddy:install": "node scripts/download-caddy.mjs",
    "deploy": "pnpm migrate && wrangler deploy --env $CLOUDFLARE_ENV --minify",
    "deploy:workers": "pnpm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate:secret": "node scripts/generate-secret.mjs",
    "generate": "drizzle-kit generate --config drizzle.config.mjs",
    "migrate": "drizzle-kit migrate --config drizzle.config.mjs",
    "test:do": "vitest run --config vitest.config.ts",
    "test:coverage": "sh scripts/test-coverage.sh",
    "check:do-hibernation": "node scripts/check-durable-object-hibernation.mjs",
    "check:do-hibernation:fixtures": "node scripts/check-durable-object-hibernation.mjs --fixtures",
    "check:workers-bundle": "node scripts/check-workers-bundle.mjs",
    "test:hook": "pnpm run check:do-hibernation && pnpm run check:workers-bundle && pnpm test:do && deno task test:authn && deno task test:permissions && deno task test:authz && deno task test:paths && deno task test:compose && deno task test:managed && deno task test:admin"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.43.1",
    "hono": "4.12.23",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^5.20260704.1",
    "drizzle-kit": "^0.31.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.109.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
