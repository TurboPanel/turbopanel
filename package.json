{
  "name": "turbopanel",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cert:generate": "node scripts/generate-self-signed-cert.mjs",
    "caddy:install": "node scripts/download-caddy.mjs",
    "deploy": "pnpm migrate && wrangler deploy --env $CLOUDFLARE_ENV --minify",
    "deploy:workers": "pnpm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate:secret": "node scripts/generate-secret.mjs",
    "generate": "drizzle-kit generate --config drizzle.config.mjs",
    "migrate": "drizzle-kit migrate --config drizzle.config.mjs",
    "test:do": "vitest run --config vitest.config.ts",
    "check:do-hibernation": "node scripts/check-durable-object-hibernation.mjs",
    "check:do-hibernation:fixtures": "node scripts/check-durable-object-hibernation.mjs --fixtures"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.43.1",
    "hono": "4.12.23",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.38",
    "@cloudflare/workers-types": "^5.20260704.1",
    "drizzle-kit": "^0.31.1",
    "vitest": "~3.0.5",
    "wrangler": "^4.109.0"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
