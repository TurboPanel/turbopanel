{
  "name": "turbopanel",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cert:generate": "node scripts/generate-self-signed-cert.mjs",
    "caddy:install": "node scripts/download-caddy.mjs",
    "deploy": "pnpm migrate && wrangler deploy --env $CLOUDFLARE_ENV --minify",
    "deploy:workers": "pnpm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate:secret": "node scripts/generate-secret.mjs",
    "seed-catalog": "node --experimental-strip-types scripts/seed-catalog.ts",
    "migrate": "drizzle-kit migrate && pnpm run seed-catalog",
    "seed": "pnpm run seed-catalog"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.43.1",
    "hono": "4.12.23",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1",
    "wrangler": "^4.98.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
