{
  // Standalone-only: ignored while Connected Mode is bound (see AGENTS.md).
  // Migrations must also be excluded in SonarCloud Analysis Scope.
  "files.associations": {
    ".secretscan-allowlist": "plaintext"
  },
  "sonarlint.connectedMode.project": {
    "connectionId": "turbopanel",
    "projectKey": "turbopanel_turbopanel"
  },
  "sonarlint.analysisExcludesStandalone": "**/migrations/**,**/migrations/*.sql",
  "sonarlint.rules": {
    "typescript:S2187": {
      "level": "off"
    }
  }
}
