# TurboPanel reverse proxy (dev + production).
#
#   /api/*  and  /ws/*  -> Deno instance (Unix socket)
#   everything else      -> Expo dev server (dev) or static export (production)
#
# API/WS surfaces are versioned: /api/{client,admin,daemon}/v1 and
# /ws/{client,admin,daemon}/v1 (plus the unversioned /api/health probe).
#
# Env:
#   TURBOPANEL_UI_MODE       "dev" | "static" (default: static)
#   EXPO_PORT                Expo dev server port when UI_MODE=dev (default: 8081)
#   TURBOPANEL_UI_ROOT       Static export directory when UI_MODE=static
#   TURBOPANEL_SOCKET_DIAL   Unix socket dial path for instance
#   CADDY_PORT               Listen port (default: 8443)
#   CADDY_TLS_CERT           Server leaf cert (default: ./certs/self-signed.crt, signed by certs/ca.crt)
#   CADDY_TLS_KEY            Server leaf key (default: ./certs/self-signed.key)
{
	auto_https off
	admin off
}

# Bind all interfaces so the proxy is reachable via LAN IP, not just localhost.
:{$CADDY_PORT:8443} {
	tls {$CADDY_TLS_CERT:./certs/self-signed.crt} {$CADDY_TLS_KEY:./certs/self-signed.key}

	@api path /api/*
	handle @api {
		reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
			header_up X-Real-IP {remote_host}
		}
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
			header_up X-Real-IP {remote_host}
		}
	}

	# Dev: proxy to Expo's web dev server (TURBOPANEL_UI_MODE=dev).
	@ui_dev expression `"{$TURBOPANEL_UI_MODE:static}" == "dev"`
	handle @ui_dev {
		route {
			vars expoUpstream true
			reverse_proxy 127.0.0.1:{$EXPO_PORT:8081} {
				header_up Host 127.0.0.1:{$EXPO_PORT:8081}
			}
		}
	}

	# Expo is often still binding when Caddy starts — show a spinner instead of a bare 502.
	handle_errors 502 503 {
		@expoUpstream vars expoUpstream true
		handle @expoUpstream {
			root * .
			rewrite * /expo-loading.html
			file_server {
				status 200
			}
		}
	}

	# Production: serve the exported Expo web app (pnpm export --platform web -> ui/dist).
	handle {
		root * {$TURBOPANEL_UI_ROOT:../ui/dist}
		try_files {path} /index.html
		file_server
	}
}
