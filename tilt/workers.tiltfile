load("./common.tiltfile", "COLORS", "PORTS")
load("ext://uibutton", "cmd_button", "location")

def run_workers_mode():
    if config.tilt_subcommand != "down":
        print("")
        print("-----------------------------------------")
        print("Services:")
        print("  TurboPanel (Workers)  @ http://localhost:" + str(PORTS["workers"]))
        print("  Daemon               @ (no port)")
        print("")
        print("Custom Buttons: Switch to Deno")
        print("Press Ctrl+C to stop all services")
        print("=========================================")

    local_resource(
        name = "turbopanel (workers)",
        labels = ["Runtime"],
        serve_cmd = "pnpm exec wrangler dev",
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = ["src/workers.ts", "src/app.ts", "wrangler.jsonc"],
    )

    wrapper_active = os.environ.get("TILT_WRAPPER_ACTIVE", "") == "1"
    switch_cmd = ["node", "scripts/set-dev-mode.mjs", "deno"] if wrapper_active else ["sh", "-c", "tilt down -- workers && tilt up deno"]

    cmd_button(
        "switch-to-deno",
        argv = switch_cmd,
        location = location.NAV,
        icon_name = "speed",
        text = "Switch to Deno",
    )
