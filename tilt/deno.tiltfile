load("./common.tiltfile", "COLORS", "PORTS", "SOCKET_DIR", "SOCKET_PATH", "SOCKET_DIAL", "deno_bin", "deno_serve_env", "caddy_bin", "node_bin_dir", "node_serve_env")
load("ext://uibutton", "cmd_button", "location")

def run_deno_mode():
    if config.tilt_subcommand != "down":
        lan_ips = str(local("hostname -I 2>/dev/null | tr ' ' '\\n' | grep -v '^$' | head -3", quiet = True)).strip().split("\n")
        lan_ips = [ip for ip in lan_ips if ip != ""]

        print("")
        print("-----------------------------------------")
        print("Services:")
        print("  TurboPanel  @ https://localhost:" + str(PORTS["caddy"]) + "  (Caddy)")
        for ip in lan_ips:
            host = "[" + ip + "]" if ":" in ip else ip
            print("              @ https://" + host + ":" + str(PORTS["caddy"]) + "  (LAN)")
        print("    /api/*, /ws  -> Deno     @ unix://" + SOCKET_PATH)
        print("    everything else -> Expo  @ http://localhost:" + str(PORTS["expo"]))
        print("  Daemon      @ (no port)")
        print("")
        print("Custom Buttons: Switch to Workers")
        print("Press Ctrl+C to stop all services")
        print("=========================================")

    node = node_bin_dir() + "/node"

    local_resource(
        name = "socket-setup",
        labels = ["Proxy"],
        cmd = node + " scripts/ensure-socket-dir.mjs",
        env = node_serve_env(),
        deps = ["scripts/ensure-socket-dir.mjs"],
    )

    deno_env = dict(deno_serve_env())
    deno_env["TURBOPANEL_SOCKET"] = SOCKET_PATH

    local_resource(
        name = "turbopanel (deno)",
        labels = ["Runtime"],
        serve_cmd = deno_bin() + " run --allow-env --allow-sys=networkInterfaces --allow-read=" + SOCKET_DIR + ",../daemon,./certs --allow-write=" + SOCKET_DIR + " --allow-run=git --watch src/deno.ts",
        serve_env = deno_env,
        resource_deps = ["socket-setup"],
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = ["src/deno.ts", "src/app.ts", "src/deno-ws.ts", "src/daemon-hub.ts", "src/daemon-routes.ts", "src/daemon-version.ts", "src/server-addresses.ts", "src/server-paths.ts", "certs", "deno.json"],
    )

    cert_env = dict(node_serve_env())
    extra_tls_sans = os.environ.get("TURBOPANEL_TLS_EXTRA_SANS", "")
    if extra_tls_sans != "":
        cert_env["TURBOPANEL_TLS_EXTRA_SANS"] = extra_tls_sans

    # Ensure Caddy is downloaded and the self-signed cert exists before Caddy serves.
    local_resource(
        name = "caddy-setup",
        labels = ["Proxy"],
        cmd = node + " scripts/download-caddy.mjs && " + node + " scripts/generate-self-signed-cert.mjs",
        env = cert_env,
        deps = ["scripts/download-caddy.mjs", "scripts/generate-self-signed-cert.mjs", ".env"],
    )

    # Expo web dev server (UI). Caddy proxies all non-API/WS traffic here.
    # EXPO_UNSTABLE_HEADLESS=1 makes Expo treat this as a headless environment, so it
    # skips preparing/launching the React Native DevTools (fusebox) Electron shell --
    # that GUI app can't run on this headless server and only errors out otherwise.
    expo_env = dict(node_serve_env())
    expo_env["EXPO_UNSTABLE_HEADLESS"] = "1"
    local_resource(
        name = "expo (web)",
        labels = ["Runtime"],
        serve_cmd = "pnpm exec expo start --web --port " + str(PORTS["expo"]),
        serve_dir = "../ui",
        serve_env = expo_env,
        trigger_mode = TRIGGER_MODE_AUTO,
    )

    # Caddy HTTPS reverse proxy mirroring the wrangler routing locally.
    # Bootstrap scripts run before every caddy start so a deleted runtimes/caddy tree is recreated.
    caddy_env = {
        "CADDY_PORT": str(PORTS["caddy"]),
        "TURBOPANEL_SOCKET_DIAL": SOCKET_DIAL,
        "TURBOPANEL_UI_MODE": "dev",
        "EXPO_PORT": str(PORTS["expo"]),
    }
    if extra_tls_sans != "":
        caddy_env["TURBOPANEL_TLS_EXTRA_SANS"] = extra_tls_sans

    local_resource(
        name = "caddy",
        labels = ["Proxy"],
        serve_cmd = node + " scripts/download-caddy.mjs && " + node + " scripts/generate-self-signed-cert.mjs && " + caddy_bin() + " run --config Caddyfile --adapter caddyfile",
        serve_env = caddy_env,
        resource_deps = ["caddy-setup", "socket-setup"],
        trigger_mode = TRIGGER_MODE_AUTO,
        deps = ["Caddyfile", ".env", "certs/ca.crt", "certs/self-signed.crt", "certs/self-signed.key"],
    )

    wrapper_active = os.environ.get("TILT_WRAPPER_ACTIVE", "") == "1"
    switch_cmd = ["node", "scripts/set-dev-mode.mjs", "workers"] if wrapper_active else ["sh", "-c", "tilt down -- deno && tilt up workers"]

    cmd_button(
        "switch-to-workers",
        argv = switch_cmd,
        location = location.NAV,
        icon_name = "bolt",
        text = "Switch to Workers",
    )
