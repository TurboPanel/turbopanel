# TurboPanel reverse proxy (production, Let's Encrypt).
#
#   /api/*, /ws/*, /webhook/*  -> Deno instance (Unix socket)
#   everything else            -> static UI export
#
# Selected when turbopanel_tls_mode=lets_encrypt. Caddy issues and renews the
# instance hostname's own certificate (HTTP-01 on :80, HTTPS on :443). This is
# the only Caddyfile where automatic HTTPS is left on. Tenant hosting leaves
# stay on the per-server hosting Caddy — never this file.
#
# The catch-all below answers `try_files {path} /index.html`, so ANY prefix the
# instance owns must be matched before it. A missed prefix does not 404 — it
# serves the SPA shell with HTTP 200, and a Git provider reads that as a
# delivered webhook and never retries. Add the matcher when you add the surface.
#
# Co-located development uses a separate Caddyfile from the turbopanel/dev
# overlay (orchestration/Caddyfile under the dev checkout). Expo proxy,
# plaintext HTTP, wrangler upstream, and local daemon download routes live
# there only — never in this file. ACME mode is managed-install only.
#
# Env:
#   TURBOPANEL_UI_ROOT            Static export directory (default: /opt/turbopanel/share/ui)
#   TURBOPANEL_SOCKET_DIAL        Unix socket dial path for instance
#   TURBOPANEL_PUBLIC_HOSTNAME    Public DNS name Caddy obtains a certificate for
#   TURBOPANEL_CADDY_ACME_EMAIL_DIRECTIVE  Full `email <addr>` line when an ACME
#                                contact is configured; empty expansion omits
#                                the directive so Caddy never sees `email `
{
	# Localhost-only admin so `systemctl reload` / `caddy reload` can swap
	# certificates without killing the process. Public-urls apply runs through
	# this reverse proxy (incl. Cloudflare → origin); a full restart mid-request
	# surfaces as HTTP 502 at the edge.
	admin localhost:2019
	# ACME account contact. The unit sets this to `email <addr>` only when
	# turbopanel_acme_email is non-empty; an empty expansion is a blank line.
	{$TURBOPANEL_CADDY_ACME_EMAIL_DIRECTIVE}
}

# Bind the public hostname so Caddy serves HTTPS on :443 and the HTTP-01
# challenge (plus the HTTP→HTTPS redirect) on :80. No explicit `tls` line —
# automatic HTTPS issues the leaf into XDG_DATA_HOME.
{$TURBOPANEL_PUBLIC_HOSTNAME} {
	# Forwarding headers are believable only from a connector on this host — a
	# `cloudflared` tunnel beside Caddy, or another local proxy. Strip any
	# client-supplied copy so a daemon dialling this proxy over the network
	# cannot declare its own address; the instance reads CF-Connecting-IP /
	# X-Forwarded-For only when its immediate peer is loopback
	# (TURBOPANEL_TRUSTED_PROXY_CIDRS widens that set).
	@remote_peer not remote_ip 127.0.0.0/8 ::1
	request_header @remote_peer -CF-Connecting-IP
	request_header @remote_peer -True-Client-IP
	request_header @remote_peer -X-Forwarded-For

	@api path /api/*
	handle @api {
		# Defense in depth only — the app itself enforces the real per-route
		# budgets (a few KB for auth, 2 MB for the largest daemon body) via
		# streaming readers that never buffer past the limit either way. This
		# just keeps an oversized request from reaching the app socket at all.
		request_body {
			max_size 8MB
		}
		reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
			header_up X-Real-IP {remote_host}
		}
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
			header_up X-Real-IP {remote_host}
		}
	}

	# Inbound Git provider webhooks. Its own top-level prefix because the caller
	# is GitHub or GitLab — no session, no daemon JWT, no Origin — so it is a
	# different class of traffic from /api. X-Real-IP is load-bearing here: the
	# webhook rate limiter keys per peer address, and without it every delivery
	# on the instance shares one bucket.
	@webhook path /webhook/*
	handle @webhook {
		# Defense in depth — GITHUB_WEBHOOK_MAX_BODY_BYTES / GITLAB_WEBHOOK_MAX_BODY_BYTES
		# are both 1 MB; the app's own streaming reader is the authoritative limit.
		request_body {
			max_size 2MB
		}
		reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
			header_up X-Real-IP {remote_host}
		}
	}

	# Serve the exported Expo web app (pnpm export --platform web -> ui/dist).
	handle {
		root * {$TURBOPANEL_UI_ROOT:/opt/turbopanel/share/ui}
		try_files {path} /index.html
		file_server
	}
}
