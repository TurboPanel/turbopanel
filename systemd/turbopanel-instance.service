[Unit]
Description=TurboPanel instance dev stack (Tilt Deno mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turbopanel
Group=turbopanel
WorkingDirectory=/opt/turbopanel/platform/turbopanel
Environment=HOME=/opt/turbopanel
ExecStart=/opt/turbopanel/platform/turbopanel/scripts/run-instance-tilt.sh
ExecStop=/bin/bash -lc 'cd /opt/turbopanel/platform/turbopanel && tilt down -- deno'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
