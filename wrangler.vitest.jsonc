{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-instance-test",
  "main": "src/workers-vitest.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "83edd62a2d7e4e6ba8b5d77b01ca3729"
    },
    {
      // Future: vitest does not hit a real Hyperdrive cache — placeholder for the
      // binding only; resolveWorkersQueryCache relies on passthrough. Do not point
      // at primary HYPERDRIVE.
      "binding": "HYPERDRIVE_CACHED",
      "id": "0000000000000000000000000000dev0"
    }
  ],
  "alias": {
    "nodemailer": "./src/lib/email/smtp/nodemailer-shim.ts",
    "@turbopanel/email/smtp-sender": "./src/lib/email/smtp/smtp-sender-shim.ts"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAEMON_CELL",
        "class_name": "DaemonCellObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-daemon-cell",
      "new_sqlite_classes": ["DaemonCellObject"]
    }
  ],
  "vars": {
    "TURBOPANEL_SECRET": "TEST_ONLY_TURBOPANEL_SECRET_aa_daemon_cell_vitest_b"
  }
}
