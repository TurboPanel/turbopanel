{
  "imports": {
    "hono": "jsr:@hono/hono@^4.12.23"
  },
  "tasks": {
    "deps": "npm install hono@4.12.23 --no-save --no-package-lock",
    "start": "deno run --allow-net src/deno.ts",
    "dev": "deno run --allow-net --watch src/deno.ts",
    "tilt": "node scripts/tilt-wrapper.mjs",
    "tilt:deno": "node scripts/tilt-wrapper.mjs deno",
    "tilt:workers": "node scripts/tilt-wrapper.mjs workers",
    "workers:dev": "wrangler dev",
    "workers:deploy": "wrangler deploy --minify",
    "workers:typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
