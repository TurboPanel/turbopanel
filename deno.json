{
  "name": "turbopanel",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "exports": "./src/app.ts",
  "imports": {
    "@std/testing/bdd": "jsr:@std/testing@1/bdd",
    "@std/testing/mock": "jsr:@std/testing@1/mock",
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding/base64": "jsr:@std/encoding@1/base64",
    "@std/encoding/base64url": "jsr:@std/encoding@1/base64url",
    "@std/path": "jsr:@std/path@1",
    "drizzle-orm": "npm:drizzle-orm@^0.43.1",
    "drizzle-orm/postgres-js": "npm:drizzle-orm@^0.43.1/postgres-js",
    "drizzle-orm/pg-core": "npm:drizzle-orm@^0.43.1/pg-core",
    "hono": "jsr:@hono/hono@^4.12.23",
    "postgres": "npm:postgres@^3.4.7",
    "amqplib": "npm:amqplib@^2.0.1",
    "nodemailer": "npm:nodemailer@^6.10.1",
    "@turbopanel/email/smtp-sender": "./src/lib/email/smtp/smtp-sender.ts",
    "ioredis": "npm:ioredis@^5.11.1",
    "yaml": "npm:yaml@^2.8.0",
    "@noble/hashes/": "npm:@noble/hashes@1.8.0/"
  },
  "exclude": ["ts-deno-globals.d.ts"],
  "lint": {
    "rules": {
      "exclude": ["no-slow-types", "require-await"]
    },
    "exclude": ["scripts/", "ts-deno-globals.d.ts"]
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "tasks": {
    "compile": "deno compile --allow-env --allow-sys=networkInterfaces,hostname --allow-read=/run/turbopanel,/etc/turbopanel,/var/lib/turbopanel,/opt/turbopanel/vendor,/opt/turbopanel/share/ui,/opt/turbopanel/lib/daemon,/opt/turbopanel/lib/instance --allow-write=/run/turbopanel,/var/lib/turbopanel --allow-net=127.0.0.1:5672,127.0.0.1:8123,dl.trbp.nl:443,api.github.com:443,gitlab.com:443,unix:/run/turbopanel/instance.sock,unix:/var/run/turbopanel/postgres/.s.PGSQL.5432,unix:/run/turbopanel/redis.sock --allow-run=sudo,/usr/bin/sudo,/bin/sh,pamtester,/usr/bin/pamtester -o dist/turbopanel-instance src/deno.ts",
    "compile:dev": "deno compile --allow-env --allow-sys=networkInterfaces,hostname --allow-read=/run/turbopanel,/etc/turbopanel,/var/lib/turbopanel,/opt/turbopanel/vendor,/opt/turbopanel/share/ui,/opt/turbopanel/lib/daemon,/opt/turbopanel/lib/instance --allow-write=/run/turbopanel,/var/lib/turbopanel --allow-net=127.0.0.1:4983,127.0.0.1:5672,127.0.0.1:1025,127.0.0.1:8123,dl.trbp.nl:443,api.github.com:443,gitlab.com:443,unix:/run/turbopanel/instance.sock,unix:/var/run/turbopanel/postgres/.s.PGSQL.5432,unix:/run/turbopanel/redis.sock --allow-run=git,systemctl,tar,sudo,/usr/bin/sudo,/bin/sh,mkfifo,/usr/bin/mkfifo,pamtester,/usr/bin/pamtester,/opt/turbopanel/vendor/node/current/bin/node -o dist/turbopanel-instance-dev src/deno-dev.ts",
    "check:types": "sh scripts/check-types.sh",
    "test:permissions": "deno test --allow-read --allow-env=TURBOPANEL_DAEMON_REPO src/deno-compile-permissions.test.ts",
    "test:authz": "deno test --allow-env --allow-net --allow-read src/client/authz/",
    "test:authn": "deno test --no-check --allow-env --allow-net --allow-read src/client/authn/workers-onboarding.test.ts src/client/authn/install-state.test.ts",
    "test:paths": "deno test --allow-read --allow-write src/server-paths.deno.test.ts",
    "test:compose": "deno test --allow-read --allow-env src/lib/compose/",
    "test:managed": "deno test --allow-read --allow-env src/lib/managed/",
    "test:managed-hostfree": "deno test --no-check --allow-read --allow-env=TURBOPANEL_DAEMON_DEBUG,TURBOPANEL_LOG_LEVEL src/client/managed/*.hostfree.test.ts src/client/managed/*-pure.test.ts src/client/managed/apply-prepare-preflight.test.ts",
    "test:admin": "deno test --no-check --allow-env --allow-net --allow-read --allow-write=/run/turbopanel,/var/run/turbopanel src/admin/reencrypt-secrets.test.ts src/admin/routes.test.ts"
  }
}
